# Copy this file to .env and fill in your real values. Never commit .env.

# --- Postgres 14 (your existing DB) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=mpesa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Anngatz3112#
# Or set DATABASE_URL directly to override the pieces above:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# --- Auth ---
SECRET_KEY=replace_with_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- ML models ---
MODELS_DIR=./models_store
# Applies the notebook's category keyword-override layer (matches the
# balanced-accuracy numbers reported during training). Set to false to get
# raw model output only. See backend/app/ml/category_overrides.py.
ENABLE_CATEGORY_OVERRIDES=true

# --- OCR ---
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=tesseract

# --- CORS: comma separated list of allowed frontend origins ---
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25000
