        "display(df[['completion_time', 'details', 'amount']].head(3))\n",
        "\n",
        "def iqr_bounds(s):\n",
        "    Q1, Q3 = s.quantile(0.25), s.quantile(0.75)\n",
        "    IQR = Q3 - Q1\n",
        "    return Q1 - 1.5 * IQR, Q3 + 1.5 * IQR\n",
        "\n",
        "numeric_cols = [c for c in ['paid_in', 'withdrawn', 'amount'] if c in df.columns]\n",
