        "}).reindex(cat_counts.index)\n",
        "\n",
        "print(\"STEP 3 \\u2500 TRANSACTION CATEGORY (6 final spending categories)\")\n",
        "display(cat_df)\n",
        "\n",
        "majority   = cat_counts.max()\n",
